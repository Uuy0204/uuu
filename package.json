{
  "name": "xiaoduyiqing",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "concurrently -n web,server -c green,cyan \"pnpm --filter @xiaoduyiqing/web dev\" \"pnpm --filter @xiaoduyiqing/server dev\"",
    "start": "pnpm dev",
    "build": "pnpm --filter @xiaoduyiqing/server build && pnpm --filter @xiaoduyiqing/web build",
    "test": "pnpm -r test",
    "lint": "eslint apps --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "pnpm -r type-check",
    "check": "pnpm type-check && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.1.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "concurrently": "^9.2.1"
  }
}
